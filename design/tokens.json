{
  "color": {
    "wallpaper": { "top": "#0B1F57", "mid": "#1747A8", "bottom": "#2B78E6" },
    "island": {
      "glass-base": { "value": "#0A0E18", "opacity": 0.62, "note": "idle/compact pills use 0.85" },
      "highlight": { "from": "#FFFFFF1F", "to": "#FFFFFF03", "direction": "top-bottom" },
      "border": { "from": "#FFFFFF61", "to": "#FFFFFF12", "width": 1 },
      "card": "#FFFFFF17"
    },
    "text": { "primary": "#FFFFFF", "secondary": "#FFFFFFA6" },
    "accent": { "blue": "#4CA0FF", "green": "#34D17A", "orange": "#FF9F0A", "purple": "#B07CFF", "teal": "#3AD6C4" }
  },
  "size": {
    "island": {
      "idle": { "w": 126, "h": 34, "radius": 17 },
      "media": { "w": 200, "h": 34, "radius": 17 },
      "charging": { "w": 150, "h": 34, "radius": 17 },
      "notification": { "w": 120, "h": 34, "radius": 17, "note": "design shows icon-only pill; code expands to 240x44" },
      "focus": { "w": 150, "h": 34, "radius": 17 },
      "expanded": { "w": 460, "h": 170, "radius": 34, "note": "code value" },
      "expanded-home": { "w": 460, "h": 250, "radius": 36, "note": "needs WINDOW_H >= ~270 in code" },
      "expanded-media": { "w": 360, "h": 130, "radius": 28 },
      "expanded-performance": { "w": 340, "h": 130, "radius": 28 },
      "expanded-notification": { "w": 380, "h": 90, "radius": 28 }
    },
    "top-gap": 8
  },
  "effect": {
    "shadow": { "x": 0, "y": 8, "blur": 24, "color": "#00000059" },
    "background-blur": "20-30 (set manually in Figma; SVG import cannot carry it)"
  },
  "typography": {
    "family": "Segoe UI Variable (fallback Segoe UI / Inter in Figma)",
    "clock": { "size": 64, "weight": 700 },
    "title": { "size": 14, "weight": 600 },
    "body": { "size": 12.5, "weight": 400 },
    "caption": { "size": 11.5, "weight": 400, "opacity": 0.6 }
  },
  "motion": {
    "expand": { "damping": 0.72, "period_ms": 55 },
    "collapse": { "damping": 0.85, "period_ms": 45 },
    "pill-to-pill": { "damping": 0.80, "period_ms": 40 }
  }
}
